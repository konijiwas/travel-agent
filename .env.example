# ── DeepSeek LLM(OpenAI 兼容,换模型只改这三行)──
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── 队列 ──
TA_QUEUE_BACKEND=auto          # auto | redis | memory(Redis 不可用自动降级内存队列)
TA_REDIS_URL=redis://127.0.0.1:6379/0

# ── 流程开关 ──
TA_AUTO_ADJUST=false           # true:预算/天气调整免确认(全部留痕)
TA_MAX_CLARIFY_ROUNDS=2        # 需求追问最多轮数
TA_COST_LIMIT_USD=0.15         # 单次任务成本上限(美元)
TA_TOOL_TIMEOUT_S=5            # MCP 工具调用超时秒数
TA_DB_PATH=data/travel.db      # SQLite 会话/决策留痕
TA_TRACE_DIR=data/traces       # trace JSONL 目录
